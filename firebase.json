{
  "hosting": {
    "site": "eswar-adapa",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "_backup/**",
      "docs/**",
      "**/*.md",
      "nginx-eswar-site.conf"
    ],
    "rewrites": [
      { "source": "/technical", "destination": "/index.html" },
      { "source": "/startup", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|gif|svg|ico|woff|woff2|pdf|mp3)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      }
    ]
  }
}
